# Deny by default. Only what the image needs is allowed back in, so private keys, local databases and
# environment files can never enter a build, whatever the working tree happens to contain.
*

!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!app
!src
!scripts
scripts/*
!scripts/reconcile.mjs
!scripts/copy-maplibre-worker.mjs
!home-node
home-node/*
!home-node/home-node.mjs

# Self-hosted fonts (SIL OFL files and their licence), served from /fonts by the standalone server.
!public
public/*
!public/fonts
!public/samples

# The published city data the Places area reads at runtime. Its collector cache and node_modules stay out.
!stadtstack-data
stadtstack-data/*
!stadtstack-data/out

# The 1 October hosted evidence that the public /replay page bundles statically (public tx hashes and amounts only).
!docs
docs/*
!docs/evidence
docs/evidence/*
!docs/evidence/HOSTED_SHARE_DEPOSIT_ROBINHOOD_TESTNET_2026-10-01.json
!docs/evidence/HOSTED_LOAN_STAKES_ROBINHOOD_TESTNET_2026-10-01.json
!docs/evidence/HOSTED_PER_TOKEN_AI_ANSWER_ROBINHOOD_TESTNET_2026-10-01.json

# The public Robinhood Chain testnet deployments the app reads at fixed paths (addresses, code hashes, parameters
# only): Local stakes and the AI desk's payee, the shared loan market with its price mirror, share deposits and the
# building revenue distributor. Artifacts, other manifests and keys stay out.
!contracts
contracts/*
!contracts/evm
contracts/evm/*
!contracts/evm/deployments
contracts/evm/deployments/*
!contracts/evm/deployments/local-investments-46630.json
!contracts/evm/deployments/shared-market-46630.json
!contracts/evm/deployments/share-deposit-46630.json
!contracts/evm/deployments/building-revenue-46630.json
