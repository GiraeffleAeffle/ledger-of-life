{
  "name": "ledger-of-life",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "An interactive rental deposit workspace for tenants, landlords, and human arbitrators.",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --hostname localhost --port 4175",
    "build": "next build",
    "start": "next start --hostname localhost --port 4175",
    "lint": "next typegen && tsc --noEmit && eslint .",
    "test": "node scripts/test.mjs",
    "setup": "node scripts/setup-local.mjs",
    "reconcile": "node --env-file-if-exists=.env.local scripts/reconcile.mjs",
    "test-signer": "SOLANA_TEST_SIGNER_MODE=1 node --no-warnings --env-file-if-exists=.env.local --experimental-strip-types scripts/test-signer.mjs"
  },
  "dependencies": {
    "@privy-io/node": "0.35.0",
    "@privy-io/react-auth": "3.45.0",
    "@solana-program/memo": "0.10.0",
    "@solana-program/token-2022": "0.6.1",
    "@solana/kit": "5.5.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/extensions": "2.27.0",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "styled-components": "6.5.3",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "ws@>=8.0.0 <8.21.0": "8.21.3"
  }
}
