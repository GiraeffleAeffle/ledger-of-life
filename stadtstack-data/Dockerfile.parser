# syntax=docker/dockerfile:1
# Build from stadtstack-data only. This image never copies the checkout, CAS or secrets.
# The base digest is shared with the existing, pinned runtime Dockerfile.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 poppler-utils tesseract-ocr tesseract-ocr-deu tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /input /scratch /opt/stadtstack/src /opt/stadtstack/regional \
    && chmod 0555 /input /opt/stadtstack
COPY --chmod=0444 src/district-parser-worker.py /opt/stadtstack/parser-worker.py
WORKDIR /opt/stadtstack
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY --chmod=0444 src/district-adapter-contract.ts src/district-structured-parser-worker.ts \
    src/district-document.ts src/district-document-parser-worker.ts src/district-parser-isolation.ts src/district-contract-source.ts src/district-execution-profile.ts \
    src/district-policy-inspection-worker.ts src/pdf-tdm-policy-worker.ts src/district-regional-statement-worker.ts \
    src/document-origin-contract.ts src/document-origin-rules.ts src/source-policy.ts src/registered-source-policy.ts src/public-address.ts \
    src/council-oparl.ts src/dedupe.ts src/common.ts ./src/
COPY src/adapters/*.ts ./src/adapters/
COPY --chmod=0444 regional/statements.mjs ./regional/statements.mjs
RUN chmod -R a-w /opt/stadtstack
ENV PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC \
    HOME=/scratch/home TMPDIR=/scratch/tmp \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata OMP_THREAD_LIMIT=1
USER 65534:65534
WORKDIR /scratch
ENTRYPOINT ["/usr/bin/env", "-i", "PATH=/usr/local/bin:/usr/bin:/bin", "LANG=C.UTF-8", "LC_ALL=C.UTF-8", "TZ=UTC", "HOME=/scratch/home", "TMPDIR=/scratch/tmp", "TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata", "OMP_THREAD_LIMIT=1", "/usr/bin/python3", "-I", "-S", "/opt/stadtstack/parser-worker.py"]
# Operator procedure (not authorization to execute): build after security review with
# docker build --file Dockerfile.parser --tag stadtstack-parser:review .
# Record the resulting immutable sha256 image ID and parserIsolationContractSha256().
# A privileged reviewer installs /etc/stadtstack/parser-isolation-review.json,
# root:root, mode 0644, under root-owned nonwritable directories. Its schema is
# exported from src/district-parser-isolation.ts. No runtime pull is permitted.
