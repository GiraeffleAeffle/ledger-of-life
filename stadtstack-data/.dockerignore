# Explicit release-only context: no caches, credentials, tests or local env files.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!src/
!src/**
!regional/
!regional/taxonomy.mjs
!release/
!release/**
# Historical output, caches and tests remain excluded by the default deny above.
**/out/
**/cache/
**/.cache/
**/test/
**/tests/
**/*.test.*
**/*.spec.*
# Defense in depth if a credential ever lands in an included directory.
**/.env*
**/.npmrc
**/*token-hashes*
**/*.pem
**/*.key
