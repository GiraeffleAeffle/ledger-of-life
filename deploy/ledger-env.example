# KEY NAMES ONLY. Copy this file OUTSIDE every repository (for example to ~/ledger-env.local, chmod 600), fill in the real
# values there, and never commit or paste the filled file.
#
# Store it as Secret ledger-env only through a separately approved, Lease-aware Secret operation.
# See docs/DEPLOYMENT.md: one shared-Lease supervisor and a reviewed fenced launcher are required.
# Never invoke the old original-infra wrapper directly or manually create/remove session locks.
#
# The existing deploy/apply.sh --secret refuses a file other users can read or one inside a git work tree, shows
# only the key names and asks for a typed confirmation. --secret replaces the WHOLE Secret: include every key
# you intend to keep in this file. It restarts the web Deployment if one exists and waits for readiness.
#
# Generate the reconcile secret locally, do not reuse another one:
#
#   openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
#
# The public Privy app id is NOT here: it is compiled into the browser bundle, so it is a build argument of the image.

# The Privy app's secret.
PRIVY_APP_SECRET=REPLACE_ME

# Optional: the verification key of Privy access tokens, a PEM on one line with literal \n between the lines (the app
# converts them back). Leave it commented out unless you have the key; a wrong value makes every sign-in fail.
# PRIVY_VERIFICATION_KEY=

# Bearer secret of the scheduled reconcile job (at least 32 random characters).
RECONCILE_SECRET=REPLACE_ME

# Solana devnet RPC. A keyed HTTPS URL is secret because its key sits in the URL. The public endpoint below
# also works, but is rate limited. Never use mainnet; these test tokens have no real value.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional ordered server-only RPC fallbacks: secondary first, official public devnet last.
# A JSON array of HTTPS devnet URLs, imported through Secret ledger-env (envFrom), never NEXT_PUBLIC_*.
# Configure owner-controlled provider URLs privately; never print URLs or keys.
# This common policy covers public/private reads and exact signed-byte recovery, not just display data.
# Leave empty for a single endpoint; localnet never uses devnet fallbacks.
SOLANA_RPC_FALLBACK_URLS=[]

# Sponsor keypair: a JSON array of 64 integers on ONE line, without surrounding quotes.
# Generate a fresh key used ONLY by this host; never reuse a personal wallet or commit the filled file.
SOLANA_SPONSOR_KEYPAIR=REPLACE_ME

# Dedicated Robinhood testnet price updater key (0x-prefixed 32-byte hex), the one the shared market's feed names as
# its updater. Its only power is copying the TSLA price: at most one push per hour, within 20% of the previous one.
# Fund only with test ETH from https://faucet.testnet.chain.robinhood.com/.
# Without it the price scope is unconfigured and the market pauses borrowing once the last price is 26 h old.
ROBINHOOD_PRICE_UPDATER_PRIVATE_KEY=REPLACE_ME

# Optional dedicated host-only Robinhood testnet faucet key (0x-prefixed 32-byte hex). Its ONLY use is sending
# 0.00005 test ETH to a signed-in person's verified wallet below 0.00001 ETH: once per 24 h per account/wallet,
# at most 200 drips per UTC day. Fund with a little test ETH from https://faucet.testnet.chain.robinhood.com/.
# Never use a personal/mainnet key. Without it people keep using the public faucet.
# ROBINHOOD_GAS_DRIP_PRIVATE_KEY=

# Dedicated Robinhood testnet fee key for paid AI answers (0x-prefixed 32-byte hex), used only by this host. It settles
# only Permit2 authorizations people already signed, to the payee and amount in them. Fund it with a little test ETH.
LOCAL_AI_FACILITATOR_PRIVATE_KEY=REPLACE_ME
