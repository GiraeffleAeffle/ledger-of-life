# Local-only defaults. npm run setup creates .env.local and a random worker secret.
APP_ORIGIN=http://localhost:4175
LOCAL_DATABASE_PATH=.data/rental.sqlite
ALLOW_LOCAL_STORE=1
# Lets this server fetch the Home Assistant address a signed-in person enters. Local runs only: on a shared host it
# would let any account make the server reach into that host's network. Production builds refuse it unless set to 1.
ALLOW_HOME_ASSISTANT_PULL=1
RECONCILE_SECRET=

# Hosted deployment: set DATABASE_URL and APP_ORIGIN to the actual HTTPS origin.
# Remove ALLOW_LOCAL_STORE=1; ephemeral filesystem storage is not a hosted database.
DATABASE_URL=

# Privy development app. Public ID only; never expose the app secret.
# Configure the exact app origin in the provider dashboard before enrolling passkeys.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional app client (Privy dashboard > App settings > Clients). Each client has its own allowed origins, so a hosted
# build can use one restricted to its domain while local development uses the app's defaults. Public, like the app ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# Robinhood: one reviewed immutable deployment and accepted agreement.
# See docs/ROBINHOOD_NATIVE_API.md. Sending stays disabled by default.
ROBINHOOD_RPC_URL=
ROBINHOOD_ESCROW_ADDRESS=
ROBINHOOD_ESCROW_CODE_HASH=
ROBINHOOD_AGREEMENT_ID=
ROBINHOOD_SEND_ENABLED=0
ROBINHOOD_SPONSOR_PRIVATE_KEY=
ROBINHOOD_SPONSOR_MAX_GAS=
ROBINHOOD_SPONSOR_MAX_FEE_WEI=
ROBINHOOD_SPONSOR_MAX_TOTAL_FEE_WEI=

# Solana: test network only; full JSON manifest in the operator guide.
# Never paste a mainnet keypair. Use a dedicated test fee payer.
SOLANA_RPC_URL=
SOLANA_DEPLOYMENT_MANIFEST=
SOLANA_SPONSOR_KEYPAIR=

# Server-only investment provider configuration.
# Price-only Jupiter reads do not require a key. A quote is not an executed trade.
JUPITER_API_KEY=
ZEROX_API_KEY=
# Enable only after the provider grants the required RWA access.
ZEROX_RWA_ENABLED=0

# The separate project atlas (city read model and map centre). Unset, the app uses http://localhost:4317. An empty
# value means this deployment has no atlas (the hosted demo sets it so): the city is still chosen, the bundled
# snapshots still load and the map centre comes from a geocode. Places mentions the atlas only when a configured
# atlas does not answer; an atlas that does not cover the city is not an outage either.
# STADTSTACK_ATLAS_URL=http://localhost:4317

# Local inference: the Next server must be able to reach this Ollama host.
# No cloud fallback. Do not expose the Ollama port directly to the public internet.
LOCAL_AI_OLLAMA_URL=
# Hosted mode: leave LOCAL_AI_OLLAMA_URL empty; paired hosts dial APP_ORIGIN over HTTPS.
# Contest owner allowlist: comma-separated verified EVM wallet addresses; empty disables invitation creation.
LOCAL_AI_HOST_OWNER_WALLETS=
LOCAL_AI_MODEL=qwen3.8:27b-ud-q3-k-xl
LOCAL_AI_HARDWARE_LABEL=Local inference host
# Enables free public answers in direct or connector mode; connector owners must opt in per host.
# Three attempts per visitor, thirty shared attempts per UTC day; no residence checks.
LOCAL_AI_LIBRARY_ENABLED=0
# Questions and answers are removed from the database this many seconds after an answer ends (default 600, max 86400).
# The reconcile job (scope local-ai) enforces it; usage counts and payment receipts are kept.
LOCAL_AI_TEXT_GRACE_SECONDS=600
# Optional: defaults to the existing local-investments manifest operator.
LOCAL_AI_PAY_TO=
# Dedicated private fee key, created by the explicit setup CLI; never a user key.
LOCAL_AI_FACILITATOR_KEY_FILE=.testnet-secrets/local-ai/facilitator.key
